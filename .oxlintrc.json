{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
