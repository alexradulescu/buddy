# Buddy - Environment Variables

# InstantDB Configuration
# Get your app ID from: https://instantdb.com/dash
VITE_INSTANTDB_APP_ID=your_instantdb_app_id_here

# Vercel AI Gateway API Key
# Get your key from: https://vercel.com/ai-gateway
# Qwen 3.5 Flash is primary; GPT OSS 20B is the automatic fallback.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here
